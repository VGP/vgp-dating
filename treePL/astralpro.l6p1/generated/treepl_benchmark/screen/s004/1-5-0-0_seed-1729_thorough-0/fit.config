# ASTRAL-Pro l6p1 analysis configuration.
# Shared input for benchmarking and the final dated-tree run.
# Relative paths are resolved from this directory.
treefile = /Users/rapyron/Documents/GitHub/vgp-dating/trees/astralpro.l6p1.tre
outfile = result.tre

# Last saved numerical settings; the benchmark screens its requested smoothing grid.
# Its initial iteration budget is --pliter (default 50), independent of this saved value.
numsites = 162228 # total gene trees supplied by Siavash
nthreads = 1
smooth = 0.10000000000000001
pliter = 50
plsimaniter = 5000
seed = 1729

# Last saved optimizer settings; the benchmark selects opt/optad and detail flags.
opt = 1
#moredetail
optad = 5
#moredetailad
optcvad = 4
moredetailcvad

# Optional standalone run modes; launcher --thorough enables screening/CV; final fits always compare both modes.
#thorough
#prime

# Branch lengths: substitution units (user confirmed).
# Calibration authority: ../../calibrations/master_calibrations.csv
# omitted_calibration_ids = CAL001,CAL002,CAL003,CAL004,CAL033,CAL038,CAL039
# Approved omissions: absent outgroup divergences and salamander divergences.
# CAL015: retain Lampris/Polymixia at node 641 despite expanded descendants.
# CAL094: retain Colius/Merops at node 1077 (Coraciimorphae).
# Ages and defining accessions are unchanged from the master CSV.

cviter = 3

