#LOAD THE TREE
# -need to optimize smooth via cv
# -need to set numsites correctly: sites or trees?
treefile = roadies_v1.1.16b.nwk
smooth = 1
numsites = 123141


#CALIBRATION - ROOT
mrca = ROOT GCA_040954625.2 GCF_028018845.1
min = ROOT 538.8
max = ROOT 635

#CALIBRATION - CROCODYLIA
mrca = CROCODYLIA GCA_030020295.1 GCF_030867095.1
min = CROCODYLIA 77.9
max = CROCODYLIA 113.2

#CALIBRATION - ANURA
mrca = ANURA GCA_040206685.1 GCA_048569485.1
min = ANURA 121.4
max = ANURA 252.0

#CALIBRATION - DORSIPARES
mrca = DORSIPARES GCA_038501925.1 GCA_037306005.1
min = DORSIPARES 150.8
max = DORSIPARES 252.0

#CALIBRATION - SQUAMATA
mrca = SQUAMATA GCA_046126795.1 GCA_964252035.1
min = SQUAMATA 167.2
max = SQUAMATA 252.0

#CALIBRATION - UNIDENTATA
mrca = UNIDENTATA GCA_035046505.1 GCA_964252035.1
min = UNIDENTATA 148.0
max = UNIDENTATA 252.0

#CALIBRATION - LATERATA
mrca = LATERATA GCA_023333525.2 GCA_964252035.1
min = LATERATA 130.2
max = LATERATA 252.0

#CALIBRATION - TOXICOFERA
mrca = TOXICOFERA GCA_021292165.1 GCA_964273705.1
min = TOXICOFERA 167.0
max = TOXICOFERA 252.0

#CALIBRATION - PYTHONS
mrca = PYTHONS GCF_035149785.1 GCA_030867105.1
min = PYTHONS 48.0
max = PYTHONS 252.0


#SET OUTFILE AND PARALLEL
outfile = roadies_v1.1.16b.treePL.tre
nthreads = 8

#SET THOROUGH SEARCH AND PRIME OPTIMIZATION
thorough
[prime]

#PRIME OPTIMIZATION RESULTS
opt = 4
optad = 4
optcvad = 3
moredetailcvad

#CV TO OPTIMIZE SMOOTH
[cv]
[cvoutfile = roadies_v1.1.16b.treePL.cv.out]