+// Alternate screened methods, retaining the best state for this training problem.
+bool optimize_full(pl_calc_parallel &plp, vector<double> *params, const OptimOptions *optims, bool cv) {
+    if(optims->polish.empty() || plp.lf) return optimize_pass(plp,params,optims,cv);
+    OptimOptions local(*optims);
+    local.polish.clear();
+    // One exploratory round at independent starts; continuation is local only.
+    if(local.lfsimaniter > 0) {
+        OptimOptions explore(local);
+        explore.pliter = explore.cviter = 1;
+        optimize_pass(plp,params,&explore,cv);
+    }
+    local.lfsimaniter = 0;
+    local.pliter = local.cviter = 1;
+    while(true) {
+        double before = plp.calc_pl(*params);
+        for(const vector<int> &method:optims->polish) {
+            local.bestopt = method[0];
+            local.bestadopt = method[1];
+            local.bestcvopt = method[2];
+            optimize_pass(plp,params,&local,cv);
+        }
+        double after = plp.calc_pl(*params);
+        cout << "polish cycle: " << before << " -> " << after << endl;
+        if(!isfinite(after) || before-after <= min(1e-10,optims->ftol)*max(1.0,fabs(before))) break;
+    }
+    return true;
+}
