+// States are specific to the input tree, constraints and parameter order.
+// CV states also record the held-out node mask; mismatched masks are ignored.
+bool read_state(const string &path, vector<double> &params, const vector<int> &mask) {
+    ifstream in(path.c_str());
+    size_t n, m;
+    if(!(in >> n >> m) || n != params.size() || m != mask.size()) return false;
+    for(int expected:mask) {
+        int value;
+        if(!(in >> value) || value != expected) return false;
+    }
+    vector<double> candidate(n);
+    for(double &value:candidate)
+        if(!(in >> value) || !isfinite(value) || value < 0) return false;
+    params = candidate;
+    return true;
+}
+
+void write_state(const string &path, const vector<double> &params, const vector<int> &mask) {
+    ofstream out(path.c_str());
+    out << params.size() << " " << mask.size() << "\n";
+    for(int value:mask) out << value << " ";
+    out << "\n" << setprecision(17);
+    for(double value:params) out << value << "\n";
+    if(!out) throw runtime_error("Cannot write state: " + path);
+}
+
+void consider_state(const string &path, pl_calc_parallel &plp, vector<double> &params,
+                    const vector<int> &mask, bool required=false) {
+    if(path.empty()) return;
+    vector<double> candidate(params);
+    if(!read_state(path,candidate,mask)) {
+        if(required) throw runtime_error("Invalid starting state: " + path);
+        return;
+    }
+    double current = plp.calc_pl(params), proposed = plp.calc_pl(candidate);
+    if(isfinite(proposed) && proposed < LARGE && (!isfinite(current) || proposed < current))
+        params = candidate;
+    plp.calc_pl(params);
+}
